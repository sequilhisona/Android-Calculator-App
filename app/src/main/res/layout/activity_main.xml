<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:fontFamily="sans-serif">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculator"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#172033"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simple calculations made easy"
            android:textSize="15sp"
            android:textColor="#788397"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- First number -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="First Number"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#344054"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etNumber1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Enter first number"
            android:inputType="numberDecimal|numberSigned"
            android:singleLine="true"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            android:textColor="#172033"
            android:textColorHint="#98A2B3"
            android:backgroundTint="#536DFE" />

        <!-- Second number -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Second Number"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#344054"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etNumber2"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Enter second number"
            android:inputType="numberDecimal|numberSigned"
            android:singleLine="true"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            android:textColor="#172033"
            android:textColorHint="#98A2B3"
            android:backgroundTint="#536DFE" />

        <!-- Operations -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Operation"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#344054"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="+"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnSubtract"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="−"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMultiply"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="×"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnDivide"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="÷"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Result -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="24dp"
            android:background="#E8EDFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RESULT"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="#536DFE" />

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="#172554"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Clear button -->
        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:text="CLEAR ALL"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:backgroundTint="#D92D20"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
